generator client {
  provider = "prisma-client-js"
}

// SQLite. On Render the file lives on the persistent disk (see render.yaml).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

model Customer {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  phone           String?
  bikeNotes       String?
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  bookings        Booking[]
}

model Booking {
  id              String         @id @default(cuid())
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Service price at booking time, so later price changes don't rewrite history.
  priceCents      Int            @default(0)
  accessToken     String         @unique
  serviceId       String
  customerName    String
  customerEmail   String
  customerPhone   String?
  notes           String?
  start           DateTime
  end             DateTime
  // PENDING_PAYMENT | CONFIRMED | IN_PROGRESS | READY_FOR_PICKUP | COMPLETED | CANCELLED
  status          String         @default("PENDING_PAYMENT")
  // ONLINE (card on the site) or AT_PICKUP
  paymentMethod   String         @default("ONLINE")
  paidAt          DateTime?
  tipCents        Int            @default(0)
  // Promo code used at booking: the code text and amount are copied so history stays right if the code changes.
  promoCodeId     String?
  promo           PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCode       String?
  discountCents   Int            @default(0)
  stripePaymentId String?        @unique
  googleEventId   String?
  createdAt       DateTime       @default(now())
  updates         StatusUpdate[]

  @@index([start])
}

model StatusUpdate {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  message   String?
  createdAt DateTime @default(now())
}

// Every email the site tries to send, so the owner can see what went out or why it failed.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  provider  String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Days the shop is closed (Kyle is away). Dates are YYYY-MM-DD in the shop's time zone.
model TimeOff {
  id        String   @id @default(cuid())
  date      String   @unique
  note      String?
  createdAt DateTime @default(now())
}

// Discount codes the owner creates. kind PERCENT (value = percent off) or AMOUNT (value = cents off).
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  kind           String
  value          Int
  note           String?
  active         Boolean   @default(true)
  // Last day the code works (YYYY-MM-DD, shop time zone). Empty = no end date.
  expiresOn      String?
  // Most bookings the code can be used on in total. Empty = unlimited.
  maxUses        Int?
  onePerCustomer Boolean   @default(false)
  createdBy      String?
  createdAt      DateTime  @default(now())
  bookings       Booking[]
}
