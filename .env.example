# Database (SQLite file locally)
DATABASE_URL="file:./dev.db"

# Public URL of the site (no trailing slash)
SITE_URL="http://localhost:3000"

# Owner dashboard: the first admin is created from these when no admin exists yet
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-please"
SESSION_SECRET="any-long-random-string"

# Stripe (dashboard.stripe.com > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email for booking confirmations (pick one; leave both blank to just log emails)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=your Gmail address, SMTP_PASS=a Google app password
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Or Resend (resend.com), once your domain is verified there:
RESEND_API_KEY=""
# Sender shown to customers, e.g. "Bikes By Kyle <kylestevenanderson2@gmail.com>"
EMAIL_FROM=""
# Who gets "new booking" emails (comma separated). Blank = every admin account.
NOTIFY_EMAILS=""

# Google Calendar (see SETUP.md). Leave blank to run without calendar sync.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
